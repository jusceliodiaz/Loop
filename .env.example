NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Project Settings → API → service_role key. Server-only, bypasses RLS — never expose this.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LiveKit Cloud — https://cloud.livekit.io
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_URL=wss://your-project.livekit.cloud
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# Stripe — Basic/Pro subscription billing (config/plans.ts)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price ids of your two recurring monthly plans (Product catalog → create a recurring price each)
STRIPE_PRICE_ID_BASIC=price_...
STRIPE_PRICE_ID_PRO=price_...
